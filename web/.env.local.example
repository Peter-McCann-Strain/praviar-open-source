# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXX
CLERK_SECRET_KEY=sk_test_XXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional custom Clerk domain for CSP script-src.
# NEXT_PUBLIC_CLERK_DOMAIN=clerk.praviar.example

# API Backend (REQUIRED)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL for OpenGraph metadata (REQUIRED in production)
# NEXT_PUBLIC_APP_URL=https://app.praviar.example

# RDKit WASM CDN (optional override)
# NEXT_PUBLIC_RDKIT_CDN_URL=https://unpkg.com/@rdkit/rdkit@2025.3.4-1.0.0/dist/RDKit_minimal.js
