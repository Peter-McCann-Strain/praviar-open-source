{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@praviar/shared-types": ["./src/lib/shared-types"],
      "@praviar/showcase-fixture": [
        "../packages/showcase-fixture/typescript/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/matrix-520/types/**/*.ts",
    ".next/matrix-520/dev/types/**/*.ts",
    "**/*.mts",
    ".next-playwright-public/types/**/*.ts",
    ".next-playwright-public/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "test-results",
    "playwright-report",
    "playwright-report-staging",
    "src/_archive"
  ]
}
