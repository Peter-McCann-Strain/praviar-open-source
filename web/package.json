{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "dead-code": "knip --config knip.json --include files,dependencies,unresolved",
    "dead-code:production": "knip --config knip.production.json --production --include files",
    "quality:duplication": "jscpd ../api/src ../praviar_pipeline/src src --min-lines 10 --min-tokens 80 --threshold 0.75 --reporters console --ignore '**/generated/**,**/*.generated.*,**/__generated__/**'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live-database": "PLAYWRIGHT_LIVE_DATABASE=true playwright test live-database-surfaces.spec.ts --workers=1",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:staging-journeys": "playwright test --config playwright.staging.config.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@praviar/showcase-fixture": "workspace:*",
    "@clerk/nextjs": "^6.39.2",
    "@floating-ui/react": "^0.27.19",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/browser": "^10.53.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.34.3",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react": "7.37.5",
    "jscpd": "4.0.5",
    "jsdom": "^26.1.0",
    "knip": "6.31.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.8"
  }
}
