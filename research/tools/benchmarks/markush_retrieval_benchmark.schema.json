{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praviar.example/schemas/markush-retrieval-benchmark-v2.json",
  "title": "Sealed Markush Retrieval Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_scope",
    "sealed_at",
    "curation_methodology",
    "curation_organization",
    "curation_protocol_sha256",
    "curation_artifact_sha256",
    "candidate_pool_protocol_sha256",
    "retrieval_cutoff",
    "thresholds",
    "cases",
    "dataset_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "markush-retrieval-benchmark-v2"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_scope": {
      "enum": ["fixture", "production"]
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "curation_methodology": {
      "type": "string",
      "minLength": 1
    },
    "curation_organization": {
      "type": "string",
      "minLength": 1
    },
    "curation_protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "curation_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_pool_protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retrieval_cutoff": {
      "type": "integer",
      "minimum": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_recall_min",
        "family_recall_min",
        "family_precision_min"
      ],
      "properties": {
        "category_recall_min": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact",
            "scaffold",
            "developed_example",
            "markush_only"
          ],
          "properties": {
            "exact": {"$ref": "#/$defs/rate"},
            "scaffold": {"$ref": "#/$defs/rate"},
            "developed_example": {"$ref": "#/$defs/rate"},
            "markush_only": {"$ref": "#/$defs/rate"}
          }
        },
        "family_recall_min": {"$ref": "#/$defs/rate"},
        "family_precision_min": {"$ref": "#/$defs/rate"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "query_structure_sha256",
          "adjudicator_identity",
          "reviewer_identity",
          "positives",
          "adjudicated_candidates"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "query_structure_sha256": {"$ref": "#/$defs/sha256"},
          "adjudicator_identity": {"type": "string", "minLength": 1},
          "reviewer_identity": {"type": "string", "minLength": 1},
          "positives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publication_id",
                "family_id",
                "category",
                "adjudication_evidence_sha256"
              ],
              "properties": {
                "publication_id": {"type": "string", "minLength": 7},
                "family_id": {"type": "string", "minLength": 1},
                "category": {
                  "enum": [
                    "exact",
                    "scaffold",
                    "developed_example",
                    "markush_only"
                  ]
                },
                "adjudication_evidence_sha256": {"$ref": "#/$defs/sha256"},
                "full_exact_structure_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "stereo_aware_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "variable_table_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          "adjudicated_candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publication_id",
                "family_id",
                "judgment",
                "adjudication_evidence_sha256"
              ],
              "properties": {
                "publication_id": {"type": "string", "minLength": 7},
                "family_id": {"type": "string", "minLength": 1},
                "judgment": {
                  "enum": ["relevant", "not_relevant"]
                },
                "adjudication_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    },
    "dataset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "benchmark_signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark_scope": {"const": "production"}
        }
      },
      "then": {
        "required": ["benchmark_signature"],
        "properties": {
          "thresholds": {
            "properties": {
              "category_recall_min": {
                "properties": {
                  "exact": {"minimum": 0.99},
                  "scaffold": {"minimum": 0.99},
                  "developed_example": {"minimum": 0.99},
                  "markush_only": {"minimum": 0.99}
                }
              },
              "family_recall_min": {"minimum": 0.99},
              "family_precision_min": {"minimum": 0.99}
            }
          },
          "cases": {"minItems": 299}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "key_id",
        "purpose",
        "signature_base64"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "purpose": {"const": "dataset"},
        "signature_base64": {"type": "string", "minLength": 1}
      }
    }
  }
}
