{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praviar.example/schemas/markush-retrieval-observed-v2.json",
  "title": "Sealed Markush Retrieval Observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_scope",
    "dataset_sha256",
    "executed_at",
    "system_identity",
    "system_version",
    "source_tree_sha256",
    "retrieval_configuration_sha256",
    "execution_receipt_sha256",
    "cases",
    "results_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "markush-retrieval-observed-v2"
    },
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_scope": {"enum": ["fixture", "production"]},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "executed_at": {"type": "string", "format": "date-time"},
    "system_identity": {"type": "string", "minLength": 1},
    "system_version": {"type": "string", "minLength": 1},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "retrieval_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_execution_receipt_sha256",
          "retrieved"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "retrieved": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publication_id",
                "rank",
                "retrieval_lanes",
                "retrieval_receipt_sha256"
              ],
              "properties": {
                "publication_id": {"type": "string", "minLength": 7},
                "rank": {"type": "integer", "minimum": 1},
                "retrieval_lanes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "exact_structure",
                      "scaffold_structure",
                      "developed_example_structure",
                      "patentscope_markush",
                      "licensed_markush"
                    ]
                  }
                },
                "retrieval_receipt_sha256": {"$ref": "#/$defs/sha256"},
                "full_exact_structure_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "stereo_aware_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "variable_table_evidence_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    },
    "results_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_signature": {"$ref": "#/$defs/signature"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark_scope": {"const": "production"}
        }
      },
      "then": {
        "required": ["benchmark_signature"],
        "properties": {
          "cases": {"minItems": 299}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "key_id",
        "purpose",
        "signature_base64"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "purpose": {"const": "observed-results"},
        "signature_base64": {"type": "string", "minLength": 1}
      }
    }
  }
}
