digraph A06 {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.4, ranksep=0.7,
         fontname="Helvetica", label="A06 — Core data model (review-critical subset)", labelloc=t, fontsize=22];
  node [shape=record, style="filled", fillcolor="#f8fafc", color="#64748b",
        fontcolor="#0f172a", fontname="Helvetica", fontsize=9, margin="0.08,0.05"];
  edge [color="#64748b", arrowsize=0.65, fontname="Helvetica", fontsize=8];

  org [label="{ORGANIZATION|uuid id PK|name|settings}"];
  user [label="{USER|uuid id PK|uuid org_id FK|role}"];
  analysis [label="{ANALYSIS|uuid id PK|uuid org_id FK|uuid initiated_by FK|status|report_data}", fillcolor="#ecfeff", color="#0f766e"];
  event [label="{PIPELINE_EVENT|uuid id PK|uuid analysis_id FK|step_number|payload}"];
  decision [label="{ANALYSIS_REVIEWER_DECISION|uuid id PK|uuid analysis_id FK|uuid org_id FK|decision}"];
  review [label="{ANALYSIS_REVIEW_STATUS|uuid id PK|uuid analysis_id FK|uuid org_id FK|status}"];
  comment [label="{COMMENT|uuid id PK|uuid analysis_id FK|uuid org_id FK}"];
  export [label="{EXPORT_JOB|uuid id PK|uuid analysis_id FK|uuid org_id FK|status|artifact_sha256}"];
  grant [label="{EXTERNAL_REPORT_GRANT|uuid id PK|uuid analysis_id FK|uuid org_id FK|delivery_state}"];
  compound [label="{COMPOUND|uuid id PK|canonical_smiles|inchi_key}"];
  org_compound [label="{ORGANIZATION_COMPOUND|uuid org_id PK/FK|uuid compound_id PK/FK|analysis_count}"];

  org -> user [label="1 : many"];
  org -> analysis [label="1 : many"];
  user -> analysis [label="0..1 initiator : many"];
  analysis -> event [label="1 : many"];
  analysis -> decision [label="1 : many"];
  analysis -> review [label="1 : 0..1"];
  analysis -> comment [label="1 : many"];
  analysis -> export [label="1 : many"];
  analysis -> grant [label="1 : many"];
  org -> org_compound [label="1 : many"];
  compound -> org_compound [label="1 : many"];
}
