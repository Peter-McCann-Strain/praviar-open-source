digraph A09 {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.34, ranksep=0.48,
         compound=true, newrank=true, fontname="Helvetica", label="A09 — Runtime phase map", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#ecfeff", color="#0f766e",
        fontcolor="#134e4a", fontname="Helvetica", fontsize=9, margin="0.14,0.08"];
  edge [color="#475569", fontcolor="#334155", fontname="Helvetica", fontsize=8];

  input [label="Authorized compound identifier +\nproduct / process scope"];
  resolve [label="1a  Resolve identity\nPubChem + RDKit structure, synonyms, fingerprints"];
  identity [label="Configured identity review?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  stop [label="Stop with review reason", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  expand [label="1b  Expand search context\nnames + structures + CPC + assignees + process terms"];
  search [label="2a  Retrieve + normalize patent candidates\nsource health records every source outcome"];
  rank [label="2b  Rank funnel\nhard filters → composite → BM25 → optional embeddings"];
  hit_gate [label="Patent candidates found?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  no_hit [label="Zero-hit landscape + source limitations", fillcolor="#fff7ed", color="#c2410c"];
  family [label="2c  Family expansion + representative selection"];
  enrich [label="Claims + bibliography + prosecution + family + legal status\nlive collectors target unresolved record gaps"];
  regulatory [label="Regulatory-exclusivity enrichment\nexecuted after search; report input", fillcolor="#f8fafc", color="#64748b"];
  triage [label="3  Batched text triage\nrelevant / possibly relevant / not relevant"];
  triage_review [label="Optional TRIAGE_REVIEW event\nnon-blocking; pipeline continues immediately", fillcolor="#f8fafc", color="#64748b"];
  relevant [label="Post-triage relevant patent set"];
  empty [label="No-relevant-patent landscape + limitations", fillcolor="#fff7ed", color="#c2410c"];
  vision [label="2d  Optional computer-vision drawing analysis\nbounded to relevant patents"];
  vision_gate [label="Vision evidence permitted\nto influence?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  withheld [label="Diagnostic / checkpoint evidence only\nno drawing input to decision consumers", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  governed [label="Governed DrawingEvidenceStore\nstructures + confidence + provenance + similarity", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];
  analysis [label="4  Claim-program analysis\nsingle pass + evaluator + automatic escalation"];
  analysis_review [label="Configured analysis review?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  critic_gate [label="Critic enabled and analyses exist?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  critic [label="4b  Portfolio critic"];
  doe [label="5  Doctrine-of-Equivalents issue screening"];
  invalidity [label="6  Invalidity-material screening"];
  verify [label="7  Deterministic cross-verification"];
  report [label="8  Multi-stage report generation\nsections + verification + bibliography + assembly"];
  report_finalize [label="Report finalization\ninitial non-vision matter evidence index"];
  bind_review [label="Bind prompt hashes + exact claim/source spans\nreject unsupported visible claims"];
  review_brief [label="report-review/v1 bounded decision brief\nrisk + ≤1,200-character summary + ledger counts\nreceipt binds brief + full private map + prompt hashes"];
  report_review [label="Configured blocking REPORT_REVIEW?\nweb approval requires explicit attestation", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  matter [label="attach_report_runtime_metadata\ncalls build_clearance_outputs"];
  clearance_index [label="Clearance-time non-vision evidence index\nrebuilt from completed report + patent records"];
  clearance_gates [label="Coverage + authority + jurisdiction\nclaim-program + evidence-quality gates", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  coverage [label="Deterministic clearance decision", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  clear [label="ClearanceOutcome.CLEAR\nAPI: clear", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];
  unclear [label="ClearanceOutcome.UNCLEAR\nAPI: unclear", fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  blocked [label="ClearanceOutcome.BLOCKED\nAPI: blocked", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  metadata [label="Attach decision + jurisdiction records\nnon-vision evidence artifacts + matter graph"];
  write [label="Manifest + report output + completion checkpoint"];
  human [label="Downstream qualified-counsel review\nand API/export policy are separate", style="rounded,dashed,filled", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];

  input -> resolve -> identity;
  identity -> expand [label="approved / not configured"];
  identity -> stop [label="rejected / policy timeout"];
  expand -> search -> rank -> regulatory -> hit_gate;
  hit_gate -> no_hit [label="no"];
  hit_gate -> family [label="yes"];
  family -> enrich -> triage -> triage_review -> relevant;
  relevant -> empty [label="empty"];
  relevant -> vision [label="non-empty"];
  vision -> vision_gate;
  vision_gate -> withheld [label="shadow / unavailable / incomplete"];
  vision_gate -> governed [label="verified live contract"];
  vision_gate -> stop [label="live prerequisite / configuration failure"];
  empty -> analysis;
  withheld -> analysis;
  governed -> analysis;
  analysis -> analysis_review;
  analysis_review -> critic_gate [label="approved / not configured"];
  analysis_review -> stop [label="rejected / policy timeout"];
  critic_gate -> critic [label="yes"];
  critic_gate -> doe [label="no"];
  critic -> doe -> invalidity -> verify -> report;
  no_hit -> report;
  report -> report_finalize -> bind_review -> review_brief -> report_review;
  review_brief -> stop [label="invalid context / attestation", style=dashed];
  report_review -> matter [label="approved decision / not configured"];
  report_review -> stop [label="rejected / no persisted decision"];
  matter -> clearance_index -> clearance_gates -> coverage;
  coverage -> clear [label="strict clear conditions"];
  coverage -> blocked [label="uncontradicted blocking patents"];
  coverage -> unclear [label="all other states"];
  clear -> metadata;
  blocked -> metadata;
  unclear -> metadata;
  metadata -> write;
  write -> human [style=dashed];
}
