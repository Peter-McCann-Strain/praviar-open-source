digraph A10 {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.32, ranksep=0.46,
         compound=true, newrank=true, fontname="Helvetica", label="A10 — Vision extraction and evidence fusion", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#ecfeff", color="#0f766e",
        fontcolor="#134e4a", fontname="Helvetica", fontsize=8.5, margin="0.13,0.075"];
  edge [color="#475569", fontcolor="#334155", fontname="Helvetica", fontsize=7.5];

  subgraph cluster_inputs {
    label="Bounded post-triage inputs"; color="#99f6e4"; style="rounded";
    rank=same;
    patents [label="Relevant patents\nID + abstract + claims"];
    target [label="Target canonical SMILES"];
    config [label="Vision configuration\njurisdictions + limits + tools + rollout"];
  }

  eligible [label="Drawing enabled + relevant set non-empty?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  provenance [label="Build governance provenance\ninfluence-capable or shadow / internal?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  runners [label="Configured OCSR runners available?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  setup [label="Initialize configured segmenter + EPO client"];
  fullpage [label="Shadow / internal: select full-page fallback\neach fetched page becomes one segment", fillcolor="#f8fafc", color="#64748b"];
  select [label="Take first drawing_max_patents candidates\nthen apply jurisdiction allowlist"];
  any [label="Eligible patents remain?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  empty_store [label="Empty run-level DrawingEvidenceStore\nno eligible patent records or structures", fillcolor="#f8fafc", color="#64748b"];
  none [label="No drawing decision input emitted", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  fail [label="Stop drawing analysis / run\nhard prerequisite or required live-stage failure", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  acquire [label="Fetch EPO drawing pages\nbounded PDF-render fallback"];
  segment [label="Configured isolated segmenter\ndefault DECIMER; optional MolDet / ChemSAM\nor shadow full-page fallback"];
  split [label="Optional oversized-crop splitter"];
  classify [label="Image classifier\nmolecule / reaction / Markush / non-chemical"];
  preprocess [label="Jurisdiction-aware preprocessing\nhash crop + record applied steps"];
  text [label="Patent-text cross-signals\nformula + CAS/name structure + abbreviations", fillcolor="#f8fafc", color="#64748b"];
  workers [label="Configured isolated OCSR workers\ndefault MolScribe + MolSight"];
  markush [label="MarkushGrapher direct path\nspecialist rollout + validated CXSMILES", style="rounded,dashed,filled", fillcolor="#f8fafc", color="#64748b"];
  markush_gate [label="Specialist result passes confidence\n+ CXSMILES + governance gates?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  markush_structure [label="Governed Markush DrawingStructure\nCXSMILES + confidence + image hash\nno fixed-structure similarity pass", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];
  fuse [label="OCSR fusion\ntext-confirmed vote / confidence cascade / majority"];
  result_gate [label="Valid fixed structure + confidence available / above floor\n+ plausible atom count?", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  abstain [label="Per-item abstention\nsuccessful no-page / no-crop or no resolved structure", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  post [label="Repair valence + remove salts + canonicalize\nRDKit validity + InChIKey"];
  cross [label="Patent-text / PubChem cross-check\nformula + CAS + name + InChI + stereo"];
  similarity [label="Tanimoto + bidirectional substructure comparison"];
  structure [label="Fixed-structure DrawingStructure\npage/crop hashes + bbox + tool + confidence\nvalidation + stereo + similarity + risk signal"];
  store [label="Run-level DrawingEvidenceStore\nindexes PatentDrawingAnalysis records\n+ governance provenance"];
  live [label="Live influence contract passes?\nbeta/production + explicit gate + allowlist\nsigned calibration + roster/ML-BOM/image bindings", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  shadow [label="Disabled, unavailable, or shadow-only\ndrawing_evidence_for_decisions → none", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  drawing [label="Governed drawing evidence", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];

  record [label="NON-VISION PATENT RECORDS\nclaim elements + specification + prosecution\nfamily lineage + patent term + legal status", fillcolor="#eff6ff", color="#2563eb", fontcolor="#1e3a8a", fontsize=9];
  source_health [label="Source health + authoritative patent records", fillcolor="#eff6ff", color="#2563eb", fontcolor="#1e3a8a"];
  receipts [label="Live collector-run receipts\naudit metadata; reused by evidence assembly", fillcolor="#f8fafc", color="#64748b"];
  analysis [label="Claim analysis + DoE + invalidity screening"];
  verify [label="Deterministic verification"];
  draft [label="Report generation\nanalysis results + optional drawing fields"];
  pre_index [label="Report finalization\ninitial non-vision matter evidence index"];
  bind_review [label="Bind prompt hashes + exact claim/source spans\nreject unsupported visible claims"];
  review_brief [label="report-review/v1 bounded decision brief\nrisk / summary + ledger counts\nSHA-256 binds brief + full private map + prompt hashes"];
  report_review [label="Configured blocking REPORT_REVIEW?\nweb approval requires explicit attestation", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  stop [label="Stop before clearance metadata and output", fillcolor="#fef2f2", color="#b91c1c", fontcolor="#7f1d1d"];
  attach [label="attach_report_runtime_metadata\ncalls build_clearance_outputs"];
  coverage_context [label="Decision scope + coverage context"];
  index [label="Clearance-time non-vision matter evidence index\nrebuilt from completed report + patent records"];
  gates [label="Coverage + authority + jurisdiction\nclaim-program + evidence-quality gates", shape=diamond, fillcolor="#fff7ed", color="#c2410c", fontcolor="#7c2d12"];
  decide [label="ClearanceOutcome\nCLEAR / UNCLEAR / BLOCKED\nAPI: clear / unclear / blocked", fillcolor="#ecfdf5", color="#15803d", fontcolor="#14532d"];
  evidence_graph [label="Non-vision evidence artifacts + matter graph\nclearance metadata attached to report"];
  output [label="Manifest + report output"];

  patents -> eligible;
  config -> eligible;
  eligible -> none [label="no"];
  eligible -> provenance [label="yes"];
  provenance -> fail [label="live governance / bindings incomplete"];
  provenance -> runners [label="valid"];
  runners -> fail [label="none; influence-capable"];
  runners -> none [label="none; shadow / internal"];
  runners -> setup [label="available"];
  setup -> fail [label="missing; influence-capable"];
  setup -> fullpage [label="segmenter absent; shadow"];
  setup -> select [label="segmenter present; PDF fallback available"];
  fullpage -> select;
  select -> any;
  any -> empty_store [label="no"];
  any -> acquire [label="yes"];
  acquire -> fail [label="live source error; no fallback", style=dashed, constraint=false];
  acquire -> segment [weight=20];
  segment -> split [weight=20];
  split -> classify;
  classify -> preprocess;
  preprocess -> workers [weight=20];
  workers -> fuse [weight=20];
  segment -> fail [label="live execution error", style=dashed, constraint=false];
  workers -> fail [label="required live execution error", style=dashed, constraint=false];
  acquire -> abstain [label="successful lookup; no page", style=dashed, constraint=false];
  segment -> abstain [label="valid result; no crop", style=dashed, constraint=false];
  patents -> text;
  text -> fuse [weight=0];
  classify -> markush [label="enabled specialist", style=dashed];
  markush -> markush_gate [style=dashed];
  markush_gate -> preprocess [label="no; fall through", style=dashed, constraint=false];
  markush_gate -> markush_structure [label="yes", style=dashed];
  fuse -> result_gate;
  fuse -> markush_structure [label="governed Markush", style=dashed];
  result_gate -> abstain [label="no"];
  result_gate -> post [label="yes"];
  post -> cross [weight=20];
  cross -> similarity [weight=20];
  target -> similarity [constraint=false, weight=0];
  similarity -> structure -> store;
  markush_structure -> store;
  abstain -> store;
  config -> live;
  store -> live;
  empty_store -> live;
  none -> shadow;
  live -> shadow [label="no"];
  live -> drawing [label="yes"];
  drawing -> analysis;
  record -> analysis;
  analysis -> verify;
  verify -> draft;
  drawing -> draft;
  source_health -> draft;
  draft -> pre_index;
  record -> pre_index;
  source_health -> pre_index;
  pre_index -> bind_review -> review_brief -> report_review;
  review_brief -> stop [label="invalid context / attestation", style=dashed];
  report_review -> stop [label="rejected / no decision"];
  report_review -> attach [label="approved decision / not configured"];
  receipts -> attach [label="audit metadata"];
  attach -> coverage_context -> index;
  record -> index;
  source_health -> index;
  index -> gates -> decide -> evidence_graph -> output;
}
