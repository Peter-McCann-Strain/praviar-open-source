# Database
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://praviar:praviar_dev@localhost:5432/praviar

# Redis
REDIS_URL=redis://localhost:6379/0

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_XXXX
CLERK_PUBLISHABLE_KEY=pk_test_XXXX
CLERK_DOMAIN=clerk.yourdomain.com
CLERK_WEBHOOK_SECRET=whsec_XXXX

# Anthropic (for Praviar pipeline — used by Celery workers)
ANTHROPIC_API_KEY=sk-ant-XXXX

# GCS Object Storage (required in production for PDF/DOCX exports)
# Auth uses Application Default Credentials / Cloud Run Workload Identity.
GCS_BUCKET_NAME=

# Observability (required in production)
SENTRY_DSN=

# Debug mode (disable in production)
DEBUG=true
ALLOW_DEV_AUTH_BYPASS=false
