# === Praviar Pipeline Configuration ===
# Copy to .env and fill in your values

# Anthropic Claude API (required)
ANTHROPIC_API_KEY=sk-ant-api03-XXXX

# Google Cloud / BigQuery (optional — enables the configured patent dataset)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_PROJECT_ID=your-gcp-project-id

# USPTO APIs (optional)
USPTO_ODP_API_KEY=
PATENTSVIEW_API_KEY=

# EPO OPS (optional — enables European patent search)
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=

# Lens.org (optional — enables the configured Lens patent source)
LENS_API_KEY=

# KIPRIS Korea (optional — enables Korean patent search)
KIPRIS_API_KEY=

# WIPO PatentScope (optional — enables cross-lingual patent search)
PATENTSCOPE_USERNAME=
PATENTSCOPE_PASSWORD=

# Tavily (optional — enables web search for prior art)
TAVILY_API_KEY=

# Hugging Face (optional — enables authenticated model downloads)
HF_TOKEN=

# LLM Model Selection (defaults shown)
CLAUDE_TRIAGE_MODEL=claude-haiku-4-5-20251001
CLAUDE_ANALYSIS_MODEL=claude-sonnet-4-6
CLAUDE_DEEP_MODEL=claude-opus-4-6

# Rate Limits
PUBCHEM_REQUESTS_PER_SECOND=5
SURECHEMBL_REQUESTS_PER_SECOND=2

# Optional operator identity sent only to upstream scientific APIs that request it.
# Leave blank for local research-preview runs; do not publish an unverified mailbox.
SOURCE_CONTACT_EMAIL=

# BigQuery Safety
BIGQUERY_MAX_BYTES_BILLED=10737418240

# Logging
LOG_LEVEL=INFO
